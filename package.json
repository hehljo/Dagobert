{
  "name": "dagobert",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cap:sync": "npm run build && npx cap sync ios",
    "postinstall": "node scripts/spm-fork.mjs",
    "capacitor:sync:after": "node scripts/spm-fork.mjs",
    "capacitor:update:after": "node scripts/spm-fork.mjs",
    "test": "vitest run src/tests && node --test tests/*.test.mjs && node scripts/test-spm-fork.mjs",
    "test:ui": "npm run build && node scripts/test-browser.mjs",
    "test:quality": "python3 scripts/check-quality.py",
    "preview": "vite preview",
    "test:portable": "python3 scripts/test-portable.py",
    "gates": "python3 scripts/run-all-gates.py"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
